# ───────────── Tempo — environment configuration ─────────────
# Copy to .env (local dev) and fill in values. Never commit real secrets.

# Branding (central rename point; also see packages/shared/src/config.ts)
NEXT_PUBLIC_APP_NAME=Tempo

# Public URLs
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000
# Runtime override used by the token route (preferred in containers; NEXT_PUBLIC_* are baked in at build time)
REALTIME_PUBLIC_URL=http://localhost:4000
# Comma-separated headers that carry the client IP behind a proxy (e.g. cf-connecting-ip,x-forwarded-for)
AUTH_IP_HEADERS=x-forwarded-for
# Comma-separated origins allowed to open sockets / call the realtime API
ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://tempo:tempo@localhost:5432/tempo?schema=public

# Redis (matchmaking, presence, job queue, socket.io adapter)
REDIS_URL=redis://localhost:6379

# Authentication (Better Auth). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# Shared secret used to sign short-lived realtime socket tokens (HS256). openssl rand -base64 32
REALTIME_JWT_SECRET=change-me-too
# Require verified email before playing rated games? (true/false)
REQUIRE_EMAIL_VERIFICATION=false
# Sign-ups allowed per IP per minute (raise for automated test runs)
AUTH_SIGNUP_RATE_LIMIT=10

# Outbound email (optional). Without SMTP, emails are logged to the server console.
EMAIL_FROM="Tempo <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Realtime service
REALTIME_PORT=4000
# Set to "true" to use the Socket.IO Redis adapter for multi-instance fan-out
REALTIME_REDIS_ADAPTER=false

# Rating / matchmaking (see packages/shared/src/config.ts for defaults)
RATING_START=1500
MATCHMAKING_INITIAL_RANGE=100
MATCHMAKING_RANGE_STEPS=100:0,150:5,250:15,400:30,600:60,1000:120

# Analysis worker (Stockfish, GPL-3.0 — see LICENSES.md)
STOCKFISH_PATH=/usr/games/stockfish
STOCKFISH_THREADS=2
STOCKFISH_HASH_MB=128
ANALYSIS_DEPTH=16
ANALYSIS_MOVETIME_MS=0
ANALYSIS_MULTIPV=2
WORKER_CONCURRENCY=1
WORKER_HEALTH_PORT=4100

# Optional AI coaching explanations (Anthropic). Leave blank to use deterministic coaching only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Logging (NODE_ENV is set by the tooling: next/tsup set production during builds)
LOG_LEVEL=info
