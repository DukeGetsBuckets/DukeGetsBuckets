{
  "name": "tempo-chess",
  "private": true,
  "version": "0.1.0",
  "description": "Tempo \u2014 an original real-time multiplayer chess platform with Stockfish game review.",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "dev:web": "pnpm --filter @tempo/web dev",
    "dev:realtime": "pnpm --filter @tempo/realtime dev",
    "dev:worker": "pnpm --filter @tempo/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test:load": "node tests/load/socket-load.mjs",
    "db:generate": "pnpm --filter @tempo/database generate",
    "db:migrate": "pnpm --filter @tempo/database migrate:dev",
    "db:deploy": "pnpm --filter @tempo/database migrate:deploy",
    "db:studio": "pnpm --filter @tempo/database studio",
    "db:seed": "pnpm --filter @tempo/database seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.1.0",
    "tsx": "^4.20.0",
    "dotenv": "^17.2.0",
    "jose": "^6.2.0",
    "socket.io-client": "^4.8.4",
    "@tempo/shared": "workspace:*",
    "@tempo/database": "workspace:*",
    "@tempo/chess-core": "workspace:*",
    "chess.js": "^1.4.0",
    "bullmq": "^6.7.0",
    "ioredis": "^5.11.0"
  }
}
