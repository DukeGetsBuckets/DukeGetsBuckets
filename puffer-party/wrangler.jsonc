{
  "name": "puffer-party",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "PufferRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PufferRoom"] }],
  "observability": { "enabled": true }
}
