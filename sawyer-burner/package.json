{
  "name": "sawyer-burner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "npm run build && vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types -c wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply sawyer-burner --local -c wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply sawyer-burner --remote -c wrangler.jsonc",
    "deploy": "npm run build && wrangler deploy",
    "seed": "node scripts/seed-local.mjs"
  },
  "dependencies": {
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "hono": "^4.13.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.58.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.137.0"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "workerd@1.20260921.1": true,
    "esbuild@0.28.1": true
  }
}
