{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tempo-chess",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "PUBLIC_URL": "https://tempo-chess.launch2.workers.dev"
  },
  "containers": [
    {
      "class_name": "TempoContainer",
      "image": "registry.cloudflare.com/e582742f900c2b989588db680ae68940/tempo-chess:v3",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "TEMPO", "class_name": "TempoContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TempoContainer"] }]
}
